{
  "rules": {
    ".read": false,
    ".write": false,
    "usuarios": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && (root.child('usuarios').child(auth.uid).child('cargo').val() === 'Administrador' || root.child('usuarios').child(auth.uid).child('cargo').val() === 'Supervisor')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "((auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && root.child('usuarios').child(auth.uid).child('cargo').val() === 'Administrador') && (newData.exists() || auth.uid !== $uid)) || ((auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && root.child('usuarios').child(auth.uid).child('cargo').val() === 'Supervisor' && newData.child('cargo').val() !== 'Administrador' && data.child('cargo').val() !== 'Administrador') && (newData.exists() || auth.uid !== $uid)) || (auth != null && auth.uid === $uid && !root.child('sistema/inicializado').exists() && newData.child('cargo').val() === 'Administrador' && newData.child('ativo').val() === true && newData.parent().parent().child('sistema/inicializado').val() === true)",
        ".validate": "newData.hasChildren(['nome', 'cargo', 'ativo'])",
        "nome": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 120"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 120"
        },
        "login": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 40"
        },
        "contatoEmail": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 120"
        },
        "telefone": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 30"
        },
        "cargo": {
          ".validate": "newData.isString() && (newData.val() === 'Administrador' || newData.val() === 'Supervisor' || newData.val() === 'Recepcionista' || newData.val() === 'Serviço Social' || newData.val() === 'Nutrição')"
        },
        "ativo": {
          ".validate": "newData.isBoolean()"
        },
        "primeiroAcesso": {
          ".write": "auth != null && auth.uid === $uid && newData.val() === false",
          ".validate": "newData.isBoolean()"
        },
        "criadoEm": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "sistema": {
      ".read": "auth != null",
      "inicializado": {
        ".write": "auth != null && !data.exists() && newData.val() === true && newData.parent().parent().child('usuarios').child(auth.uid).child('cargo').val() === 'Administrador'",
        ".validate": "newData.isBoolean()"
      },
      "$other": {
        ".validate": false
      }
    },
    "acompanhantes": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && (root.child('usuarios').child(auth.uid).child('cargo').val() !== 'Nutrição' || (query.orderByChild === 'status' && query.equalTo === 'presente'))",
      ".indexOn": [
        "status",
        "entradaTs",
        "nomePaciente"
      ],
      "$id": {
        ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && root.child('usuarios').child(auth.uid).child('cargo').val() !== 'Nutrição') && (newData.exists() || (root.child('usuarios').child(auth.uid).child('cargo').val() === 'Administrador' || root.child('usuarios').child(auth.uid).child('cargo').val() === 'Supervisor'))",
        ".validate": "newData.hasChildren(['id', 'tipo', 'nomeAcompanhante', 'nomePaciente', 'setor', 'dataEntrada', 'horaEntrada', 'status'])",
        "id": {
          ".validate": "newData.val() === $id"
        },
        "tipo": {
          ".validate": "newData.val() === 'acompanhante' || newData.val() === 'visita'"
        },
        "status": {
          ".validate": "newData.val() === 'presente' || newData.val() === 'saiu' || newData.val() === 'trocado'"
        },
        "nomeAcompanhante": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 250"
        },
        "nomePaciente": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 250"
        },
        "documento": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 250"
        },
        "telefone": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 80"
        },
        "parentesco": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 80"
        },
        "setor": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
        },
        "leito": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 60"
        },
        "observacao": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 1200"
        },
        "recepcionistaEntrada": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 250"
        },
        "recepcionistaSaida": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 250"
        },
        "dataEntrada": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[0-9]{2}-[0-9]{4}$/)"
        },
        "dataSaida": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[0-9]{2}-[0-9]{4}$/)"
        },
        "ultimaConfirmacao": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[0-9]{2}-[0-9]{4}$/)"
        },
        "horaEntrada": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$/)"
        },
        "horaSaida": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$/)"
        },
        "entradaTs": {
          ".validate": "newData.isNumber()"
        },
        "duracaoVisita": {
          ".validate": "newData.isNumber()"
        },
        "criadoPor": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 128"
        },
        "trocas": {
          ".validate": "true"
        }
      }
    },
    "bloqueios": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && root.child('usuarios').child(auth.uid).child('cargo').val() !== 'Nutrição'",
      "$id": {
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && (root.child('usuarios').child(auth.uid).child('cargo').val() === 'Administrador' || root.child('usuarios').child(auth.uid).child('cargo').val() === 'Supervisor' || root.child('usuarios').child(auth.uid).child('cargo').val() === 'Serviço Social')",
        ".validate": "newData.hasChildren(['id', 'paciente', 'motivo', 'ativo'])",
        "id": {
          ".validate": "newData.val() === $id"
        },
        "paciente": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 250"
        },
        "setor": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 100"
        },
        "leito": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 60"
        },
        "motivo": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 800"
        },
        "solicitante": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 250"
        },
        "dataBloqueio": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 40"
        },
        "ativo": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "logs": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && (root.child('usuarios').child(auth.uid).child('cargo').val() === 'Administrador' || root.child('usuarios').child(auth.uid).child('cargo').val() === 'Supervisor')",
      ".indexOn": [
        "timestamp"
      ],
      "$id": {
        ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && !data.exists() && newData.child('usuarioId').val() === auth.uid) || (auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && root.child('usuarios').child(auth.uid).child('cargo').val() === 'Administrador' && !newData.exists() && data.child('timestamp').val() < now - 2592000000)",
        ".validate": "newData.hasChildren(['id', 'timestamp', 'usuario', 'usuarioId', 'acao', 'descricao'])",
        "id": {
          ".validate": "newData.val() === $id"
        },
        "timestamp": {
          ".validate": "newData.val() === now"
        },
        "usuario": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 250"
        },
        "usuarioId": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 128"
        },
        "descricao": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 600"
        },
        "registroId": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 128"
        },
        "acao": {
          ".validate": "newData.isString() && newData.val().matches(/^(login|logout|criar|editar|excluir|saida|troca|bloqueio|usuario|config|exportar|privacidade|visualizacao)$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "configuracoes": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && root.child('usuarios').child(auth.uid).child('cargo').val() === 'Administrador'",
      "logoHospital": {
        ".validate": "newData.isString() && newData.val().length < 700000"
      },
      "retencaoRegistrosDias": {
        ".validate": "newData.isNumber() && newData.val() >= 7 && newData.val() <= 3650"
      },
      "retencaoLogsDias": {
        ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 3650"
      },
      "controlador": {
        ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 200"
      },
      "encarregadoNome": {
        ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 150"
      },
      "encarregadoEmail": {
        ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 150"
      },
      "ultimaLimpeza": {
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && (root.child('usuarios').child(auth.uid).child('cargo').val() === 'Administrador' || root.child('usuarios').child(auth.uid).child('cargo').val() === 'Supervisor')",
        ".validate": "newData.isNumber()"
      },
      "tema": {
        ".validate": "newData.val() === 'light' || newData.val() === 'dark'"
      },
      "fundoLogin": {
        ".validate": "newData.isString()"
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
