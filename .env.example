# Copie para ".env.local" e preencha com os dados do app web do SEU projeto Firebase
# (Console Firebase -> Configurações do projeto -> Seus aplicativos -> Configuração do SDK).
# ".env.local" NUNCA vai para o GitHub (está no .gitignore). Na Vercel, cadastre estas mesmas
# variáveis em Settings -> Environment Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Domínio interno do login por "usuário" (maria -> maria@recepcao.hrpi.local). Não precisa existir.
VITE_LOGIN_DOMAIN=recepcao.hrpi.local

# (Opcional) chave pública reCAPTCHA v3 do App Check
VITE_APPCHECK_SITE_KEY=

# (opcional) Senha inicial de usuários novos (mínimo 6 caracteres; o usuário é obrigado a trocar no 1º acesso).
# Se ficar em branco, o sistema usa a senha padrão do código.
VITE_SENHA_PADRAO=
